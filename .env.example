# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional (all settings must live in .env.local: the API runs in the Workers runtime,
# which does not see variables exported in the shell)
# Per-call output cap incl. thinking; a runaway guard, not a quality limit. Model max 384000.
# DEEPSEEK_MAX_TOKENS=128000
# CHROME_PATH=/path/to/chrome-or-headless-shell
# TypeSafe Jev intent classification (optional; falls back to DeepSeek when unset or unsure)
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_MIN_CONFIDENCE=0.7
# Reasoning effort for code-writing agents: none | low | high (default) | max
# AI_AGENT_REASONING_EFFORT=high
